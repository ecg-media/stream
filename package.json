{
  "name": "stream",
  "version": "2.0.0",
  "description": "Low-latency multi-channel audio streaming for local networks using mediasoup, WebSockets and WebRTC.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/",
    "build-client": "esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=MediasoupClient --target=es2020 --outfile=app/js/mediasoup-client.js",
    "set-password": "node server/index.js --set-password"
  },
  "author": "ecg-media",
  "license": "ISC",
  "dependencies": {
    "express": "5.3.0",
    "mediasoup": "3.32.2",
    "mediasoup-client": "3.26.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "mediasoup@3.32.2": true,
    "esbuild@0.28.2": true
  }
}
